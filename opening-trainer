#!/usr/bin/env -S raku -Ilib
use Chess::GUI;
use Chess::Moves;
use DB::SQLite;

sub MAIN($book-path = q{resources/lichess-elite.polyglot}.IO) {

    use Chess::Book;

    my DB::SQLite $db  .= new: filename => "repertoire.db";
    my Chess::GUI $gui .= new;

    sub best-move(Chess::Position $position) returns Move {
        with $db.query('SELECT move FROM chosen_moves WHERE position = ?', $position.uint.base(36)).value {
            return Move.new($_);
        } else { return Move }
    }

    sub term:<search-book> returns Bag {
            polyglot-search($gui.position, $book-path)
            .map({ .<move> => .<weight> })
            .Bag
    }

    sub reset {
        $gui.reset;
        if rand < .5 {
            note "flipping board";
            with search-book {
                if .elems == 0 {
                    note "no move found at all in $book-path"
                } elsif .values.all == 0 {
                    note "all weights are zero!"
                } else {
                    note my $pick = .pick;
                    $gui.make-move: $pick;
                }
            }
            $gui.flip;
        }
        $gui.unlock;
    }

    reset;
    $gui.new-move.Supply.tap: {
        my ($move, $position) = .<move position>;
        my $best-move = best-move $position;
        if !$best-move.defined {
            note "unknown move";
            $gui.undo;
            $gui.lock;
            Promise.in(1).then: { $gui.reset; $gui.unlock }
        } else {
            if $move eq best-move($position) {
                note "that's the correct move";
                #$gui.play-sound: :correct;
                with search-book {
                    if .elems == 0 {
                        note "no move found at all in $book-path"
                    } elsif .values.all == 0 {
                        note "all weights are zero!"
                    } else {
                        note my $pick = .pick;
                        $gui.make-move: $pick;
                    }
                }
            } else {
                use Color;
                $gui.play-sound: :wrong;
                $gui.undo;
                $gui.add-arrow: :from($best-move.from), :to($best-move.to), :color(Color.new: rgba => (255, 0, 0, 64));
                $gui.lock;
                Promise.in(3).then: { $gui.reset; $gui.unlock }
            }
        }
    }
    await $gui.raylib;
}

