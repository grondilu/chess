#!/usr/bin/env -S raku -Ilib
use Chess;
use Chess::Moves;
use Chess::GUI;
use DB::SQLite;

sub MAIN {


    my DB::SQLite $db  .= new: filename => "%*ENV<HOME>/Documents/chess.sqlite";
    my Chess::GUI $gui .= new;

    react {

        whenever $gui.new-move.Supply {
            with $db.query(qq[select uci as weight from lichess where from_hash = '$gui.position.uint.base(36)' group by uci order by RANDOM()*count(*) desc limit 1]).value {
                start {
                    $gui.lock;
                    sleep .1;
                    with Move.new: $_, :color($gui.position.turn), :board($gui.position) {
                        $gui.make-move: $_
                    } else {
                        note "could not make move $_ in position $gui.position.fen()";
                        done;
                    }
                    $gui.unlock;
                }
            } else { note "no book move, quitting"; $gui.reset; }
        }
        whenever $gui.raylib {
            done;
        }
    }

}

